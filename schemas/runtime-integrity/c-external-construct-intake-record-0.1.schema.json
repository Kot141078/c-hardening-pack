{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivan-kotov:c-runtime-integrity:external-construct-intake-record:0.1",
  "title": "c External Construct Intake Record v0.1",
  "description": "Artifact-specific record for comparison, adaptation, dependency and claim boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_type","record_id","created_at","source_artifact","source_construct","local_target","relation","transformation","preserved_properties","rejected_properties","mapping_failures","terminology_substitutions","license_status","attribution","native_antecedents","independent_prior_art_refs","claim_ceiling_state","claim_assertions","narrative_fields_authoritative","claim_ceiling","witness_chain_head"],
  "properties": {
    "schema_version": {"const": "c-external-construct-intake-record-0.1"},
    "record_type": {"const": "external_construct_intake_record"},
    "record_id": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/id"},
    "created_at": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/timestamp"},
    "source_artifact": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/sourceRef"},
    "source_construct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description","source_location"],
      "properties": {
        "description": {"type": "string", "minLength": 20, "maxLength": 4000},
        "source_location": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "local_target": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1024}, "uniqueItems": true},
    "relation": {"type": "string", "enum": ["COMPARISON_ONLY","TEST_SURFACE_CATALYST","FUNCTIONAL_ANALOG","INTERFACE_ADAPTATION","FORMAL_DEPENDENCY","CODE_REUSE","NO_DEPENDENCY"]},
    "transformation": {"type": "string", "minLength": 20, "maxLength": 6000},
    "preserved_properties": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "rejected_properties": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "mapping_failures": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "terminology_substitutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["external_term","local_term","reason"],
        "properties": {
          "external_term": {"type": "string", "minLength": 1, "maxLength": 256},
          "local_term": {"type": "string", "minLength": 1, "maxLength": 256},
          "reason": {"type": "string", "minLength": 10, "maxLength": 1000}
        }
      }
    },
    "license_status": {"type": "string", "enum": ["REFERENCE_ONLY_NO_CODE_REUSE","TEXT_QUOTATION_WITHIN_LICENSE","LICENSE_CLEARED_FOR_ADAPTATION","LICENSE_REVIEW_REQUIRED","INCOMPATIBLE"]},
    "license_evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"}, "uniqueItems": true},
    "dependency_evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"}, "uniqueItems": true},
    "removal_breaks_evidence_ref": {"oneOf": [{"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"}, {"type": "null"}]},
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required","references"],
      "properties": {
        "required": {"type": "boolean"},
        "references": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    },
    "native_antecedents": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}, "uniqueItems": true},
    "independent_prior_art_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1024}, "uniqueItems": true},
    "claim_ceiling_state": {"type": "string", "enum": ["NO_DEPENDENCY_TEST_SURFACE_ONLY", "ELEVATED_RELATION_REQUIRES_PROOF"]},
    "claim_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation_claimed","dependency_claimed","priority_claimed","ontology_transfer_claimed","code_reuse_claimed"],
      "properties": {
        "derivation_claimed": {"type": "boolean"},
        "dependency_claimed": {"type": "boolean"},
        "priority_claimed": {"type": "boolean"},
        "ontology_transfer_claimed": {"type": "boolean"},
        "code_reuse_claimed": {"type": "boolean"}
      }
    },
    "narrative_fields_authoritative": {"const": false},
    "claim_ceiling": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/claimBoundary"},
    "witness_chain_head": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/sha256"}
  }
}
