{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ivan-kotov:c-runtime-integrity:consequence-commit-record:0.1",
  "title": "c Consequence Commit Record v0.1",
  "description": "Final commit-boundary revalidation record. It extends native AGL and initiation-gate doctrine; it does not create authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "created_at",
    "governing_entity_id",
    "task_contract_ref",
    "permission_grant_ref",
    "decision_basis_ref",
    "source_grounding_ref",
    "continuity_evidence_ref",
    "l4_state_ref",
    "target_effect",
    "precondition_results",
    "commit_outcome",
    "effect_state",
    "current_conditions_hash",
    "witness_chain_head",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "c-consequence-commit-record-0.1"},
    "record_type": {"const": "consequence_commit_record"},
    "record_id": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/id"},
    "created_at": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/timestamp"},
    "governing_entity_id": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/id"},
    "human_anchor_ref": {"type": ["string", "null"], "maxLength": 256},
    "agent_ref": {"type": ["string", "null"], "maxLength": 256},
    "task_contract_ref": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"},
    "permission_grant_ref": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"},
    "decision_basis_ref": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"},
    "source_grounding_ref": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/stateRef"},
    "continuity_evidence_ref": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/stateRef"},
    "l4_state_ref": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/stateRef"},
    "memory_reliance_refs": {
      "type": "array",
      "items": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/artifactRef"},
      "uniqueItems": true
    },
    "target_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "effect_class", "target_ref", "reversibility"],
      "properties": {
        "effect_id": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/id"},
        "effect_class": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CONTINUITY_SENSITIVE", "IRREVERSIBLE"]},
        "target_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "reversibility": {"type": "string", "enum": ["REVERSIBLE", "REVERSIBLE_WITH_COST", "PARTIALLY_REVERSIBLE", "IRREVERSIBLE", "UNKNOWN"]}
      }
    },
    "precondition_results": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence_ref"],
        "properties": {
          "name": {"type": "string", "enum": ["SOURCE_GROUNDING", "IDENTITY_CONTINUITY", "CURRENT_AUTHORITY", "PERIMETER", "TIME_WINDOW", "L4_BUDGET", "MEMORY_RELIANCE", "WITNESS_READINESS", "BLOCKING_STATE"]},
          "status": {"type": "string", "enum": ["PASS", "PASS_WITH_LIMITS", "FAIL", "UNKNOWN"]},
          "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "commit_outcome": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/gateOutcome"},
    "effect_state": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/effectState"},
    "effect_artifact_hash": {
      "oneOf": [
        {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "non_effect_witness_ref": {"type": ["string", "null"], "maxLength": 512},
    "previous_commit_record_ref": {"type": ["string", "null"], "maxLength": 512},
    "change_reason": {"type": ["string", "null"], "maxLength": 2000},
    "current_conditions_hash": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/sha256"},
    "witness_chain_head": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/sha256"},
    "claim_boundary": {"$ref": "urn:ivan-kotov:c-runtime-integrity:common-defs:0.1#/$defs/claimBoundary"}
  }
}
