  "scope": "Interpretation and verification layer for the two preserved standalone v0.1 checksum manifests. It changes neither manifest entries nor any checksum-manifested or DOI-bound canonical byte.",
  "authority_rule": "The preserved manifests record release-package canonical byte domains. A normalized worktree representation is admissible only when strict declared transformation reproduces that domain; exact Git blobs and extracted release archives are verified without checkout normalization.",
  "claim_boundary": "A match establishes byte identity only for the named evidence source and declared hash domain. It is not implementation, conformance, safety, legal, certification, release, or deployment evidence.",
  "text_policy": {
    "encoding": "UTF-8-strict",
    "bom": "forbidden",
    "unicode_normalization": "none",
    "newline_free_text": "accepted",
    "worktree_forms": [
      "LF",
      "CRLF"
    ],
    "invalid_forms": [
      "mixed-CRLF-LF",
      "bare-CR"
    ]
  },
  "source_claims": {
    "git_blob": "Reads exact regular-file blobs from one resolved commit and compares their raw bytes plus both raw manifests to the pinned main baseline. It separately projects declared UTF-8 text into the release canonical domain for manifest-digest comparison and reports raw versus transformed counts; canonical projection is not claimed as raw Git-blob equality.",
    "worktree": "Reads regular in-root files, rejects symlink or reparse traversal, accepts a uniform LF or CRLF checkout form for declared UTF-8 text, and transforms it to the declared canonical domain before hashing.",
    "release_archive": "Uses the policy blob from the exact --git-ref commit, reads an explicitly named extracted archive root, rejects symlink or reparse traversal, and hashes exact archive bytes without checkout normalization. The archive need not contain this policy file but must contain both manifests and already use each declared canonical text domain."
  },
